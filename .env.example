# Copy to .env and fill in real values before `make dev` or `make deploy`.

# Docker Compose
COMPOSE_PROJECT_NAME=echo-timemap

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8000

# PostgreSQL
POSTGRES_USER=echo_timemap
POSTGRES_PASSWORD=echo_timemap
POSTGRES_DB=echo_timemap
DATABASE_URL=postgresql+asyncpg://echo_timemap:echo_timemap@db:5432/echo_timemap

# Auth / JWT (generate with: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_TO_LONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS: comma-separated origins. Add the production subdomain once assigned.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin panel integration (generate with: openssl rand -hex 32)
ADMIN_API_KEY=CHANGE_ME_TO_LONG_RANDOM_STRING

# Timezone for the backend container
TZ=Europe/Madrid
